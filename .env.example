# Copy to .env and replace each value before starting the server.
NODE_ENV=development
PORT=3000

# Admin access stays disabled until BOTH values are set to private, unique values.
ADMIN_PASS=
ADMIN_SESSION_SECRET=

# Shipping and tax defaults used by the current Express server.
SHIP_STATES=WA,OR
LOCAL_ZIPS=99201,99202,99203,99204,99208
STORE_ADDR=
CARRIER=Regional Carrier
LOCAL_FEE=800
TAX_RATE=0.1065
PAY_PROVIDER=cybersource

# Optional AI chat. Leave the key and model blank to keep it disabled.
# OpenAI-compatible Chat Completions endpoint; defaults to the OpenAI endpoint below.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000

# OpenCode Zen alternative (use a supported Chat Completions model ID):
# AI_API_URL=https://opencode.ai/zen/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=glm-5.1

# Optional payment / age-verification integrations. Use sandbox credentials for development.
AGE_PROVIDER=persona
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
VERIFF_SECRET=
CYBS_ACCESS_KEY=
CYBS_PROFILE_ID=
CYBS_SECRET_KEY=
